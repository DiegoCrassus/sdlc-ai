{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "python .cursor/hooks/session_start.py",
        "timeout": 15
      }
    ],
    "sessionEnd": [
      {
        "command": "python .cursor/hooks/session_end.py",
        "timeout": 15
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "python .cursor/hooks/before_submit_prompt.py",
        "matcher": "UserPromptSubmit",
        "timeout": 10
      }
    ],
    "stop": [
      {
        "command": "python .cursor/hooks/stop.py",
        "timeout": 15
      }
    ],
    "preToolUse": [
      {
        "command": "python .cursor/hooks/pre_tool_use.py",
        "timeout": 10
      }
    ],
    "postToolUse": [
      {
        "command": "python .cursor/hooks/post_tool_use.py",
        "timeout": 10
      }
    ],
    "postToolUseFailure": [
      {
        "command": "python .cursor/hooks/post_tool_use_failure.py",
        "timeout": 10
      }
    ],
    "beforeShellExecution": [
      {
        "command": "python .cursor/hooks/before_shell.py",
        "timeout": 10
      }
    ],
    "afterShellExecution": [
      {
        "command": "python .cursor/hooks/after_shell.py",
        "timeout": 10
      }
    ],
    "beforeMCPExecution": [
      {
        "command": "python .cursor/hooks/before_mcp.py",
        "timeout": 10
      }
    ],
    "afterMCPExecution": [
      {
        "command": "python .cursor/hooks/after_mcp.py",
        "timeout": 10
      }
    ]
  }
}
