# Copie para .env e preencha os valores. Nunca commitar.
# Para MCP no Cursor (GitHub + Plane + Supabase): ./launch.sh (carrega este .env e abre o Cursor)
# Scripts shell (.sdlc/scripts/*.sh) carregam este arquivo via _load-env.sh.
# Hooks Python carregam via python-dotenv automaticamente.
# Ver .sdlc/integrations/github.md, .sdlc/integrations/plane.md e .sdlc/integrations/supabase.md

# GitHub MCP + gh CLI
# Classic PAT (ghp_...) — usado pelo MCP; precisa de scopes: repo, workflow, admin:repo_hook
GITHUB_PERSONAL_ACCESS_TOKEN_CLASSIC=
# Fine-grained PAT (github_pat_...) — alternativa para uso por repo específico
GITHUB_PERSONAL_ACCESS_TOKEN=
GITHUB_REPOSITORY=DiegoCrassus/sdlc-ai

# Plane MCP — tarefas e documentação (Pages)
# PAT: Profile Settings → API Tokens  OU  Workspace Settings → Access Tokens
PLANE_API_KEY=
# Slug na URL: https://app.plane.so/<slug>/
PLANE_WORKSPACE_SLUG=
# Opcional — self-hosted (default: https://api.plane.so)
# PLANE_BASE_URL=

# Supabase MCP — database/docs em modo read-only
# PAT: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
# Project ref: Dashboard → Project Settings → General → Reference ID
SUPABASE_PROJECT_REF=

# Deep Agent / OpenAI
AGENT_MODEL=openai:gpt-4.1-mini
OPENAI_API_KEY=

# LangSmith — suporta nomenclatura nova (LANGSMITH_*) e antiga (LANGCHAIN_*)
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=rpg-op-cursor

# Backend
DATABASE_URL=sqlite+aiosqlite:///./data/rpg_op.db

# rpg_dsl CLI (se rpg.exe não estiver no PATH, use: python -m rpg_dsl._cli)
# Instalar: pip install -e packages/rpg_dsl
# Compilar:  python -m rpg_dsl._cli compile specs/ --out generated/
# Validar:   python -m rpg_dsl._cli validate specs/
