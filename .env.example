# Copy to .env — never commit .env

# GitHub MCP + gh CLI
GITHUB_PERSONAL_ACCESS_TOKEN_CLASSIC=
GITHUB_REPOSITORY=DiegoCrassus/sdlc-ai

# Plane MCP — workspace investments-sdlc, project investiments
PLANE_API_KEY=
PLANE_WORKSPACE_SLUG=investments-sdlc
PLANE_PROJECT_NAME=investiments

# Deep Agent / OpenAI
AGENT_MODEL=openai:gpt-4.1-mini
OPENAI_API_KEY=

# Investment Radar backend (optional — fallback works without keys)
# ENABLE_LIVE_MARKET_DATA=true
# FINNHUB_API_KEY=
# ALPHA_VANTAGE_API_KEY=
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
