# Copy to .env — never commit .env

# GitHub MCP + gh CLI
GITHUB_PERSONAL_ACCESS_TOKEN=
GITHUB_REPOSITORY=DiegoCrassus/sdlc-ai

# Plane MCP
PLANE_API_KEY=
PLANE_WORKSPACE_SLUG=investments-sdlc

# Deep Agent / OpenAI
AGENT_MODEL=openai:gpt-4.1-mini
OPENAI_API_KEY=

# Backend database
DATABASE_URL=sqlite+aiosqlite:///./data/market_data.db

# Redis cache (optional — falls back to in-memory if unavailable)
REDIS_URL=redis://localhost:6379/0

# Market data mode: live | mock
MARKET_DATA_MODE=live
MARKET_DATA_SCRAPING_ENABLED=false

# Free API keys — register at provider sites (no credit card required)
FINNHUB_API_KEY=
COINGECKO_API_KEY=
BRAPI_API_KEY=

# Optional fallbacks
TWELVE_DATA_API_KEY=
ALPHA_VANTAGE_API_KEY=

# Backend server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
